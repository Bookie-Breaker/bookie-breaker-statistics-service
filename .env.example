# statistics-service environment variables
PORT=8002
LOG_LEVEL=info
# statistics_svc owns no schema; Postgres is used only to archive raw API
# responses into public.raw_api_responses
DATABASE_URL=postgres://statistics_svc:localdev@localhost:5432/bookiebreaker?search_path=public
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Comma-separated leagues this instance serves (ADR-026). Adapters exist for
# NBA (Wave 0), FIFA_WC and EPL (Wave 1), MLB and NCAA_BSB (Wave 2), and NFL
# and NCAA_FB (Wave 3; both ship dormant — their seasons resume August 2026).
LEAGUES_ENABLED=NBA

# stats.nba.com client (undocumented API; throttle generously)
NBA_STATS_BASE_URL=https://stats.nba.com
NBA_MIN_REQUEST_INTERVAL=800ms
NBA_HTTP_TIMEOUT=30s

# Official MLB StatsAPI (free, documented, keyless)
MLB_STATS_BASE_URL=https://statsapi.mlb.com/api/v1

# nflverse static CSV releases for NFL season EPA/turnover aggregates (free,
# keyless GitHub release assets)
NFLVERSE_BASE_URL=https://github.com/nflverse/nflverse-data/releases/download

# CollegeFootballData API for NCAA_FB season stats (records, SP+, scoring).
# CFBD_API_KEY is a free key; leave it empty to run NCAA_FB watcher-only
# (ESPN teams/schedule/scoreboard with empty season stats). CFBD is never
# called for live scores.
CFBD_BASE_URL=https://api.collegefootballdata.com
CFBD_API_KEY=

# Injuries come from ESPN per enabled league with an injuries path (NBA,
# MLB); set to "none" to disable and serve empty injury reports
INJURY_SOURCE=espn
ESPN_BASE_URL=https://site.api.espn.com

# Refresh cadences
REFRESH_TEAM_STATS_INTERVAL=6h
REFRESH_ROSTERS_INTERVAL=12h
REFRESH_SCHEDULE_INTERVAL=24h
REFRESH_INJURIES_INTERVAL=4h
SCOREBOARD_POLL_INTERVAL=5m

# Cache TTLs
TTL_TEAMS=24h
TTL_TEAM_STATS=6h
TTL_PLAYERS=6h
TTL_GAMES=1h
TTL_INJURIES=1h
TTL_STALE=168h

# Circuit breaker for stats.nba.com
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_DURATION=5m

# Season override (e.g. 2025 = the 2025-26 NBA season); default derives from
# the clock with an October 1 rollover
# CURRENT_SEASON=2025
